# 필수: Scriptable 이 보낼 API 키 (openssl rand -hex 32)
AIUSAGE_API_KEY=

# 토큰과 스냅샷이 저장되는 디렉터리 (권한 700 으로 생성됨)
AIUSAGE_DATA_DIR=/var/lib/aiusage

# 리버스 프록시 뒤에서 쓰므로 로컬에만 바인딩
AIUSAGE_HOST=127.0.0.1
AIUSAGE_PORT=8787

# 백그라운드 수집 주기(초, 최소 60) / 수동 새로고침 최소 간격(초)
AIUSAGE_POLL_INTERVAL=300
AIUSAGE_MIN_REFRESH_INTERVAL=60

# Antigravity 를 쓰려면 Antigravity 앱에 들어 있는 Google OAuth 클라이언트 값을 넣으세요. (README 참고)
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
